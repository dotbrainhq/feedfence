{
  "name": "feedfence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hide the distracting parts of social sites and see your time and scrolling there.",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3",
    "postinstall": "wxt prepare"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@wxt-dev/module-svelte": "2.0.5",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "web-ext": "10.8.0",
    "wxt": "0.21.4"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/schibsted-grotesk": "5.3.0"
  }
}
